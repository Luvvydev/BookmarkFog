{
  "manifest_version": 3,
  "name": "BookmarkFog",
  "version": "1.0.0",
  "description": "Local bookmark organizer with bookmark bar protection, backups, duplicate cleanup, and NSFW review.",
  "permissions": [
    "bookmarks",
    "storage",
    "downloads"
  ],
  "action": {
    "default_title": "BookmarkFog",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
